{
  "schema_version": 1,
  "name": "Œuvre 3D vers mur réel",
  "artwork": "./artwork.jpg",
  "artwork_preparation": {
    "mode": "auto_rectify",
    "minimum_confidence": 0.75,
    "inset_ratio": 0.003,
    "max_output_edge": 2048
  },
  "project": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background": [14, 15, 20],
    "quality": "fast",
    "crf": 18,
    "audio_mode": "reference"
  },
  "media": {
    "mur3": {"path": "./mur3.jpg", "kind": "image"},
    "mur2": {"path": "./mur2.jpg", "kind": "image"}
  },
  "shots": [
    {
      "id": "virtual",
      "kind": "artwork_3d",
      "duration_frames": 240,
      "settings": {
        "render_config": {
          "effect": "sand",
          "seed": 31,
          "width": 540,
          "hold_start": 0.1,
          "hold_end": 0.2
        },
        "camera": {
          "yaw": 4.0,
          "pitch": -73.0,
          "distance": 610.0,
          "motion": "top_drift",
          "motion_strength": 0.55
        },
        "lamp_brightness": 2.7,
        "lamp_motion": 0.3,
        "color_policy": {
          "mode": "faithful"
        }
      }
    },
    {
      "id": "mur3",
      "kind": "still",
      "asset": "mur3",
      "duration_frames": 90,
      "fit": "cover",
      "camera": {
        "keyframes": [
          {"frame": 0, "x": 0.49, "y": 0.5, "zoom": 1.0, "rotation_degrees": -0.25},
          {"frame": 89, "x": 0.51, "y": 0.49, "zoom": 1.08, "rotation_degrees": 0.15,
           "easing": "ease_in_out"}
        ]
      }
    },
    {
      "id": "mur2",
      "kind": "still",
      "asset": "mur2",
      "duration_frames": 120,
      "fit": "cover",
      "camera": {
        "keyframes": [
          {"frame": 0, "x": 0.52, "y": 0.5, "zoom": 1.08, "rotation_degrees": 0.15},
          {"frame": 119, "x": 0.5, "y": 0.5, "zoom": 1.0, "rotation_degrees": 0.0,
           "easing": "ease_out"}
        ]
      }
    }
  ],
  "transitions": [
    {
      "kind": "spatial_match",
      "from": "virtual",
      "to": "mur3",
      "duration_frames": 60
    },
    {
      "kind": "cut",
      "from": "mur3",
      "to": "mur2",
      "duration_frames": 1
    }
  ],
  "semantic_regions": [
    {
      "id": "profile-eye",
      "type": "eye",
      "label": "Œil du visage de profil",
      "bounds": [0.114, 0.325, 0.060, 0.120],
      "mask": {"shape": "ellipse", "feather": 0.025},
      "blink": {
        "axis": [0.04, 0.84, 0.96, 0.90],
        "curvature": 0.015,
        "amplitude": 1.0,
        "protection": 0.12,
        "seam_width": 0.010
      }
    }
  ],
  "semantic_actions": [
    {
      "id": "final-blink",
      "capability": "region.blink",
      "target": "profile-eye",
      "trigger": {"event": "shot_end", "shot": "mur3"},
      "parameters": {
        "close_frames": 6,
        "hold_frames": 2,
        "open_frames": 10,
        "intensity": 1.0,
        "easing": "ease-in-out"
      }
    }
  ],
  "outputs": {
    "control_sheet": "renders/controls.jpg",
    "export": "renders/transition.mp4",
    "control_width": 270
  }
}
